<!DOCTYPE html>
<html>

<head>
<meta charset="UTF-8">
<title>SoccerIQ - Niveau 1</title>

<style>

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background-color: #1A0000;
  color: white;
  text-align: center;
}

.topnav {
  overflow: hidden;
  background-color: #D2042D;
}

.topnav a {
  float: left;
  color: white;
  padding: 14px 16px;
  text-decoration: none;
  font-size: 17px;
}

.topnav a:hover {
  background-color: white;
  color: black;
}

.quizBox {
  background-color: white;
  color: black;
  width: 60%;
  margin: auto;
  padding: 20px;
  border-radius: 15px;
}

button {
  background-color: #D2042D;
  color: white;
  border: none;
  padding: 10px 20px;
  font-size: 18px;
  border-radius: 10px;
  cursor: pointer;
}

button:hover {
  background-color: #8B0000;
}

input {
  padding: 10px;
  font-size: 16px;
}

.question {
  display: none;
}

.active {
  display: block;
}

</style>

<script>

let currentQuestion = 0;
let score = 0;

const quizQuestions = [
{
  question: "Quelle est la valeur de pi pour tenter un tir au but? ",
  answer: "3,14"
},
{
  question: "Si une voiture conduit a 300km dans 5 heures. C’est quoi leur vitesse moyenne par heur?",
  answer: "60 km/h"
},
{
  question: "Toute les angles d’un triangle est égale a :",
  answer: "180 degré"
},
{
  question: "Un magasin vend une chemise avec une réduction de 20 %. Si le prix initial était de 50 $, quel serait le prix de vente ?",
  answer: "40$"
},
{
  question: "Quel pays a gagné la Coupe du Monde 2022 ?",
  answer: "argentine"
}
];

function startGame() {
  showQuestion();
}

function showQuestion() {

  if(currentQuestion < quizQuestions.length) {

    document.getElementById("question").innerHTML =
      quizQuestions[currentQuestion].question;

    document.getElementById("reponse").value = "";

    document.getElementById("resultat").innerHTML = "";
  }
  else {

    let message = "Ton score final : " + score + "/" + quizQuestions.length + "<br><br>";

    if(score == 5) {
      message += "🏆 Excellent joueur!";
    }
    else if(score >= 3) {
      message += "⚽ Bon travail!";
    }
    else {
      message += "💪 Continue à pratiquer!";
    }

    document.getElementById("quiz").innerHTML =
      "<h2>" + message + "</h2>";
  }
}

function verifierReponse() {

  let userAnswer =
    document.getElementById("reponse").value.toLowerCase().trim();

  let correctAnswer =
    quizQuestions[currentQuestion].answer.toLowerCase();

  if(userAnswer == correctAnswer) {

    score++;

    document.getElementById("resultat").innerHTML =
      "✅ Bonne réponse!";
  }
  else {

    document.getElementById("resultat").innerHTML =
      "❌ Mauvaise réponse! La bonne réponse était : " +
      quizQuestions[currentQuestion].answer;
  }

  currentQuestion++;

  setTimeout(showQuestion, 1500);
}

</script>

</head>

<body onload="startGame()">

<!-- Navigation -->
<div class="topnav">
  <a href="index.html">Home</a>
  <a href="Niveau2.html">Niveau 2</a>
</div>

<br>

<h1>SoccerIQ ⚽ Niveau 1</h1>

<!-- Logo -->
<img src="Image/SoccerIQlogo.png" width="25%">

<br><br>

<!-- Quiz -->
<div class="quizBox" id="quiz">

  <h2 id="question"></h2>

  <input type="text" id="reponse" placeholder="Ta réponse">

  <br><br>

  <button onclick="verifierReponse()">
    Tirer au but ⚽
  </button>

  <h2 id="resultat"></h2>

</div>

<br>

<h2>Réponds correctement pour marquer des buts!</h2>

</body>

</html>
